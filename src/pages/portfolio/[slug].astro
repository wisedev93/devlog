---
/**
 * /portfolio/[slug] — 프로젝트 상세. 데이터는 src/data/portfolio.ts
 */
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import BackButton from "@/components/BackButton.astro";
import PortfolioGallery from "@/components/PortfolioGallery.astro";
import PortfolioStatus from "@/components/PortfolioStatus.astro";
import { getCollection } from "astro:content";
import dayjs from "dayjs";
import { projects, type Project } from "@/data/portfolio";
import { SITE } from "@/config";
import { getPath } from "@/utils/getPath";

export function getStaticPaths() {
  return projects.map(project => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props as { project: Project };

// 관련 글 — id 만 적어 두고 제목·설명·날짜는 블로그 컬렉션에서 읽는다 (draft 제외)
const blogPosts = await getCollection("blog", ({ data }) => !data.draft);
const relatedPosts = (project.posts ?? []).flatMap(id => {
  const post = blogPosts.find(p => p.id === id);
  return post ? [post] : [];
});
const idx = projects.findIndex(x => x.slug === project.slug);
const next = projects[(idx + 1) % projects.length];
---

<Layout
  title={`${project.title} | Portfolio | ${SITE.title}`}
  description={project.summary}
  ogImage={project.cover}
  noindex
>
  <Header />
  <BackButton fallback="/portfolio" />
  <main id="main-content" class="app-layout">
    <header class="border-b border-border pb-10 sm:pb-12">
      <div
        class="flex flex-wrap items-center gap-2 font-app text-[11px] tracking-wider text-foreground-muted"
      >
        <PortfolioStatus status={project.status} />
        <span>{project.period}</span>
      </div>

      <h1
        class="mt-4 text-alpine pb-1 text-3xl leading-[1.2] font-bold tracking-tight sm:text-5xl"
      >
        {project.title}
      </h1>
      <p class="mt-2 max-w-3xl text-base text-foreground-muted sm:text-lg">
        {project.subtitle}
      </p>

      {
        relatedPosts.length > 0 && (
          <a
            href="#related-posts"
            class="group mt-5 inline-flex w-fit items-center gap-2 rounded-full border border-border bg-background-elevated px-4 py-2 text-xs font-medium text-foreground backdrop-blur-md transition-colors hover:border-accent hover:text-accent"
          >
            <span class="size-1.5 rounded-full bg-accent shadow-[0_0_8px_var(--accent-glow)]" />
            이 프로젝트에 대해 쓴 글 {relatedPosts.length}편
            <span
              aria-hidden
              class="transition-transform group-hover:translate-x-0.5"
            >
              ➜
            </span>
          </a>
        )
      }

      <dl
        class="mt-6 grid gap-x-8 gap-y-3 text-sm sm:grid-cols-[max-content_1fr]"
      >
        <dt
          class="font-app text-xs tracking-wider text-foreground-muted uppercase"
        >
          client
        </dt>
        <dd>{project.client}</dd>
        <dt
          class="font-app text-xs tracking-wider text-foreground-muted uppercase"
        >
          role
        </dt>
        <dd>{project.role}</dd>
        {
          project.team && (
            <>
              <dt class="font-app text-xs tracking-wider text-foreground-muted uppercase">
                team
              </dt>
              <dd>{project.team}</dd>
            </>
          )
        }
        <dt
          class="font-app text-xs tracking-wider text-foreground-muted uppercase"
        >
          stack
        </dt>
        <dd>
          <ul class="flex flex-wrap gap-1.5">
            {
              project.stack.map(s => (
                <li class="rounded-full border border-border bg-background-elevated px-2.5 py-0.5 text-xs text-foreground-muted">
                  {s}
                </li>
              ))
            }
          </ul>
        </dd>
      </dl>
    </header>

    <section class="py-10">
      <p class="max-w-3xl text-base leading-relaxed text-foreground sm:text-lg">
        {project.summary}
      </p>

      <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          project.metrics.map(m => (
            <li class="flex flex-col gap-1.5 rounded-2xl p-5 glass">
              <span class="text-xs text-foreground-muted">{m.label}</span>
              <span class="font-app text-base font-semibold text-foreground">
                {m.before && (
                  <>
                    <span class="text-foreground-muted">{m.before}</span>
                    <span class="mx-1.5 text-accent">➜</span>
                  </>
                )}
                <span class="text-accent">{m.after}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    {
      project.sections.length > 0 && (
        <section class="grid gap-10 border-t border-border py-10 lg:grid-cols-2">
          {project.sections.map(sec => (
            <article class="flex flex-col gap-3">
              <h2 class="text-lg font-semibold text-foreground">{sec.title}</h2>
              {sec.body.map(b => (
                <p class="text-sm leading-relaxed text-foreground-muted">{b}</p>
              ))}
            </article>
          ))}
        </section>
      )
    }

    {
      relatedPosts.length > 0 && (
        <section
          id="related-posts"
          class="scroll-mt-24 border-t border-border py-10"
        >
          <div class="mb-5 flex items-center gap-2">
            <span class="size-1.5 rounded-full bg-accent shadow-[0_0_8px_var(--accent-glow)]" />
            <h2 class="text-xs font-semibold tracking-[0.2em] text-foreground-muted uppercase">
              Related writing · 더 깊이 읽기
            </h2>
          </div>
          <ul class="grid gap-4 sm:grid-cols-2">
            {relatedPosts.map(post => (
              <li>
                <a
                  href={getPath(post.id, post.filePath)}
                  class="group relative flex h-full flex-col gap-3 rounded-2xl p-6 glass transition-all hover:-translate-y-0.5 hover:border-accent/60 hover:shadow-[0_8px_32px_rgba(0,0,0,0.2)]"
                >
                  <div class="flex items-center justify-between gap-3 font-app text-[11px] tracking-wider text-foreground-muted">
                    <span class="rounded-full border border-border bg-background/40 px-2 py-0.5 uppercase">
                      post
                    </span>
                    <span>
                      {dayjs(post.data.pubDatetime).format("YYYY.MM.DD")}
                    </span>
                  </div>
                  <h3 class="text-base leading-snug font-semibold text-foreground transition-colors group-hover:text-accent">
                    {post.data.title}
                  </h3>
                  <p class="line-clamp-3 text-sm leading-relaxed text-foreground-muted">
                    {post.data.description}
                  </p>
                  <span class="mt-auto inline-flex items-center gap-1 pt-1 text-xs font-semibold text-accent">
                    읽기
                    <span
                      aria-hidden
                      class="transition-transform group-hover:translate-x-0.5"
                    >
                      ➜
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      project.video && (
        <section class="border-t border-border py-10">
          <div class="mb-5 flex items-center gap-2">
            <span class="size-1.5 rounded-full bg-accent shadow-[0_0_8px_var(--accent-glow)]" />
            <h3 class="text-xs font-semibold tracking-[0.2em] text-foreground-muted uppercase">
              {project.video.title ?? "시연 영상"}
            </h3>
          </div>
          <figure class="flex flex-col items-center gap-3 sm:flex-row sm:items-end sm:gap-8">
            <video
              src={project.video.src}
              poster={project.video.poster}
              class="w-64 rounded-[1.6rem] border border-border shadow-[0_8px_32px_rgba(0,0,0,0.25)]"
              controls
              muted
              playsinline
              loop
              preload="none"
            />
            <figcaption class="max-w-sm text-sm text-foreground-muted">
              {project.video.caption}
            </figcaption>
          </figure>
        </section>
      )
    }

    {
      project.groups.length > 0 && (
        <section class="border-t border-border py-10">
          <PortfolioGallery groups={project.groups} />
        </section>
      )
    }

    <nav
      class="flex items-center justify-between border-t border-border py-8 text-sm"
    >
      <a href="/portfolio" class="text-foreground-muted hover:text-accent"
        >➜ 전체 프로젝트</a
      >
      <a
        href={`/portfolio/${next.slug}`}
        class="group inline-flex items-center gap-1.5 text-foreground hover:text-accent"
      >
        다음: {next.title}
        <span
          aria-hidden
          class="transition-transform group-hover:translate-x-0.5">➜</span
        >
      </a>
    </nav>
  </main>
  <Footer />
</Layout>

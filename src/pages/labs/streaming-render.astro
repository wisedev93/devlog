---
/**
 * /labs/streaming-render — LLM 스트리밍 답변 렌더 방식 비교.
 * 메타데이터는 src/data/labsMeta.ts 에서, island 는 src/islands/StreamingRenderLab.tsx 에서.
 */
import LabLayout from "@/layouts/LabLayout.astro";
import StreamingRenderLab from "@/islands/StreamingRenderLab";
import { getLab } from "@/data/labsMeta";

const lab = getLab("streaming-render");
if (!lab) {
  return Astro.redirect("/labs");
}
---

<LabLayout
  title={lab.title}
  summary={lab.summary}
  tags={lab.tags}
  post={lab.post}
  pubDate={lab.pubDate}
>
  <StreamingRenderLab client:visible />
</LabLayout>

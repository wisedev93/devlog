---
/**
 * 포트폴리오 스크린샷 그룹 갤러리.
 * - 데스크톱 캡처는 2열, 모바일 세로 캡처는 4~5열로 렌더
 * - 클릭하면 <dialog> 라이트박스로 원본 크기 표시 (← → / ESC)
 */
import type { ShotGroup } from "@/data/portfolio";

interface Props {
  groups: ShotGroup[];
}
const { groups } = Astro.props;
---

<div class="flex flex-col gap-14">
  {
    groups.map(group => {
      const isMobile = group.shots.every(s => s.mobile);
      return (
        <section>
          <div class="mb-5 flex items-center gap-2">
            <span class="size-1.5 rounded-full bg-accent shadow-[0_0_8px_var(--accent-glow)]" />
            <h3 class="text-xs font-semibold tracking-[0.2em] text-foreground-muted uppercase">
              {group.title}
            </h3>
          </div>
          {group.description && (
            <p class="-mt-2 mb-5 text-sm text-foreground-muted">
              {group.description}
            </p>
          )}
          <ul
            class:list={[
              "grid gap-4",
              isMobile
                ? "grid-cols-2 sm:grid-cols-3 lg:grid-cols-5"
                : "sm:grid-cols-2",
            ]}
          >
            {group.shots.map(shot => (
              <li>
                <figure class="group flex flex-col gap-2">
                  <button
                    type="button"
                    data-lightbox={shot.src}
                    data-caption={shot.caption}
                    class:list={[
                      "block w-full cursor-zoom-in overflow-hidden border border-border bg-background-elevated transition-all hover:-translate-y-0.5 hover:border-accent/60 hover:shadow-[0_8px_32px_rgba(0,0,0,0.2)]",
                      isMobile ? "rounded-[1.4rem]" : "rounded-xl",
                    ]}
                    aria-label={`${shot.caption} 크게 보기`}
                  >
                    <img
                      src={shot.src}
                      alt={shot.caption}
                      loading="lazy"
                      decoding="async"
                      class:list={[
                        "block w-full object-cover object-top",
                        isMobile ? "aspect-[720/1560]" : "aspect-[1800/1386]",
                      ]}
                    />
                  </button>
                  <figcaption class="text-xs leading-relaxed text-foreground-muted">
                    {shot.caption}
                  </figcaption>
                </figure>
              </li>
            ))}
          </ul>
        </section>
      );
    })
  }
</div>

<dialog
  id="pf-lightbox"
  class="m-auto max-h-[96vh] max-w-[96vw] overflow-visible bg-transparent p-0 backdrop:bg-black/80 backdrop:backdrop-blur-sm"
>
  <figure class="flex flex-col items-center gap-3">
    <img
      id="pf-lightbox-img"
      alt=""
      class="max-h-[86vh] max-w-[94vw] rounded-xl border border-border-strong object-contain shadow-2xl"
    />
    <figcaption id="pf-lightbox-cap" class="text-center text-sm text-white/85">
    </figcaption>
  </figure>
  <button
    type="button"
    id="pf-lightbox-close"
    class="fixed top-4 right-4 rounded-full border border-white/20 bg-black/50 px-3 py-1.5 text-xs text-white/90 hover:bg-black/70"
    aria-label="닫기">ESC ✕</button
  >
</dialog>

<script>
  function setupLightbox() {
    const dialog = document.getElementById(
      "pf-lightbox"
    ) as HTMLDialogElement | null;
    const img = document.getElementById(
      "pf-lightbox-img"
    ) as HTMLImageElement | null;
    const cap = document.getElementById("pf-lightbox-cap");
    if (!dialog || !img || !cap || dialog.dataset.ready) return;
    dialog.dataset.ready = "1";

    const triggers = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-lightbox]")
    );
    let index = 0;

    const show = (i: number) => {
      index = (i + triggers.length) % triggers.length;
      const t = triggers[index];
      img.src = t.dataset.lightbox ?? "";
      img.alt = t.dataset.caption ?? "";
      cap.textContent = t.dataset.caption ?? "";
    };

    triggers.forEach((t, i) =>
      t.addEventListener("click", () => {
        show(i);
        dialog.showModal();
      })
    );
    dialog.addEventListener("click", e => {
      if (e.target === dialog) dialog.close();
    });
    document
      .getElementById("pf-lightbox-close")
      ?.addEventListener("click", () => dialog.close());
    dialog.addEventListener("keydown", e => {
      if (e.key === "ArrowRight") show(index + 1);
      if (e.key === "ArrowLeft") show(index - 1);
    });
  }
  document.addEventListener("astro:page-load", setupLightbox);
</script>

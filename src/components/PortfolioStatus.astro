---
/**
 * 포트폴리오 프로젝트 상태 배지.
 * - ongoing    : 개발 진행 중 — labs 의 live 처럼 accent 배경 + 붉은 점 깜빡임
 * - operation  : 개발 완료 후 운영 중 — 파란색
 * - terminated : 종료 — 검은색
 */
import type { Project } from "@/data/portfolio";

interface Props {
  status: Project["status"];
  class?: string;
}

const { status, class: className } = Astro.props;

const STATUS_STYLE: Record<
  Project["status"],
  { label: string; cls: string; dot: string }
> = {
  ongoing: {
    label: "ongoing",
    cls: "bg-accent text-background",
    dot: "animate-pulse bg-red-600 shadow-[0_0_8px_2px_rgba(220,38,38,0.7)]",
  },
  operation: {
    label: "operation",
    cls: "bg-accent text-background",
    dot: "bg-blue-500 shadow-[0_0_8px_2px_rgba(59,130,246,0.75)]",
  },
  terminated: {
    label: "terminated",
    cls: "bg-accent text-background",
    dot: "bg-black/60 shadow-[0_0_6px_1px_rgba(0,0,0,0.45)]",
  },
};

const style = STATUS_STYLE[status];
---

<span
  class:list={[
    "inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-[10px] font-semibold tracking-[0.2em] uppercase",
    style.cls,
    className,
  ]}
>
  <span class:list={["size-1.5 rounded-full", style.dot]}></span>
  {style.label}
</span>
